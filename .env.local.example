# 本地开发环境变量模板
# 使用方法：cp .env.local.example .env.local，然后填入真实值
# 注意：.env.local 不要提交到 GitHub

# Supabase 项目地址（Supabase 控制台 → Project Settings → Data API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon 公钥（Supabase 控制台 → Project Settings → Data API → anon public）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service_role 密钥（Supabase 控制台 → Project Settings → Data API → service_role secret）
# 仅服务端使用（初始化管理员、提交收录的写入），绝不暴露给客户端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 数据库连接串（构建时自动建表/跑迁移用）：Supabase → Project Settings → Database，
# 用 Connection Pooling 的 session 模式连接串
# 格式：postgresql://postgres.项目ref:数据库密码@aws-0-区域.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 后台会话签名密钥：用下面的命令生成随机值，不要用弱口令
# openssl rand -hex 32
ADMIN_SESSION_SECRET=your-random-hex-secret-here

# 初始化口令（可选，强烈推荐配置）：/admin/setup 向导要求输入的口令，
# 防止部署后、你首次打开后台之前的时间窗口里被他人抢先初始化
# openssl rand -hex 16
SETUP_TOKEN=

# 首页"提交收录"的密码：配置后首页侧边栏出现"提交收录"按钮，
# 访客输入此密码即可免登录提交新链接。不配置则按钮不显示。
SUBMIT_PASSWORD=your-submit-password-here

# 本地开发环境变量模板
# 使用方法：cp .env.local.example .env.local，然后填入真实值
# 注意：.env.local 不要提交到 GitHub

# Supabase 项目地址（Supabase 控制台 → Project Settings → Data API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon 公钥（Supabase 控制台 → Project Settings → Data API → anon public）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 管理员邮箱：用于后台登录鉴权与 RLS 写权限校验
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# 后台会话签名密钥：用下面的命令生成随机值，不要用弱口令
# openssl rand -hex 32
ADMIN_SESSION_SECRET=your-random-hex-secret-here

# 首页"提交收录"的密码：配置后首页侧边栏出现"提交收录"按钮，
# 访客输入此密码即可免登录提交新链接。不配置则按钮不显示。
SUBMIT_PASSWORD=your-submit-password-here

# Supabase service_role 密钥（Supabase 控制台 → Project Settings → Data API → service_role secret）
# 仅服务端使用（提交收录的写入），绝不暴露给客户端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
